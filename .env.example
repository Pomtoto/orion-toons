# ============ إعدادات الخادم ============
PORT=3000

# ============ ترجمة اللغة (للفصول) ============
# اللغة التي تُجلب بها الفصول من المصدر: en = إنجليزية (الأكثر توفراً)
# يمكن استخدام ar للفصول العربية المتوفرة (عددها أقل)
CHAPTER_LANG=en

# ============ OCR / ترجمة الصور ============
# اختر مزوّداً واحداً فقط، واملأ مفتاحه. اتركها فارغة لتعطيل OCR الحي
# (عند التعطيل يتراجع الواجهة الأمامية تلقائياً للنموذج المحلي)

# الخيار 1: Anthropic Claude (مُستحسن — Vision قوية)
OCR_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# الخيار 2: OpenAI GPT-4o
# OCR_PROVIDER=openai
OPENAI_API_KEY=

# الخيار 3: Google Gemini
# OCR_PROVIDER=gemini
GEMINI_API_KEY=

# ============ الكاش (بالثواني) ============
CACHE_TTL_WORKS=3600
CACHE_TTL_CHAPTERS=1800
CACHE_TTL_PAGES=86400
